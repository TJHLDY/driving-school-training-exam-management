<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.drivingschool.mapper.RoleMapper">
    <resultMap id="BaseResultMap" type="Role">
        <id property="roleId" column="role_id"/>
        <result property="roleCode" column="role_code"/>
        <result property="roleName" column="role_name"/>
    </resultMap>
    <sql id="BaseColumns">role_id, role_code, role_name</sql>
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM role WHERE role_id = #{roleId}
    </select>
    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM role WHERE role_code = #{roleCode}
    </select>
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM role ORDER BY role_id
    </select>
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT r.role_id, r.role_code, r.role_name
        FROM user_role ur
        JOIN role r ON r.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
        ORDER BY r.role_id
    </select>
    <select id="countByCode" resultType="int">
        SELECT COUNT(*) FROM role WHERE role_code = #{roleCode}
    </select>
    <insert id="insert" parameterType="Role" useGeneratedKeys="true" keyProperty="roleId">
        INSERT INTO role (role_code, role_name) VALUES (#{roleCode}, #{roleName})
    </insert>
    <update id="updateById" parameterType="Role">
        UPDATE role
        <set>
            <if test="roleCode != null and roleCode != ''">role_code = #{roleCode},</if>
            <if test="roleName != null and roleName != ''">role_name = #{roleName},</if>
        </set>
        WHERE role_id = #{roleId}
    </update>
    <select id="countUserReference" resultType="int">
        SELECT COUNT(*) FROM user_role WHERE role_id = #{roleId}
    </select>
    <delete id="deleteById">
        DELETE FROM role WHERE role_id = #{roleId}
    </delete>
</mapper>
