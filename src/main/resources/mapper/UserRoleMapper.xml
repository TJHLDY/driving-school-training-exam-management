<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.drivingschool.mapper.UserRoleMapper">
    <resultMap id="BaseResultMap" type="UserRole">
        <result property="userId" column="user_id"/>
        <result property="roleId" column="role_id"/>
    </resultMap>
    <insert id="insert">
        INSERT INTO user_role (user_id, role_id) VALUES (#{userId}, #{roleId})
    </insert>
    <insert id="insertBatch">
        INSERT INTO user_role (user_id, role_id) VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT user_id, role_id FROM user_role WHERE user_id = #{userId} ORDER BY role_id
    </select>
    <select id="countByUserIdAndRoleId" resultType="int">
        SELECT COUNT(*) FROM user_role WHERE user_id = #{userId} AND role_id = #{roleId}
    </select>
    <delete id="delete">
        DELETE FROM user_role WHERE user_id = #{userId} AND role_id = #{roleId}
    </delete>
    <delete id="deleteByUserId">
        DELETE FROM user_role WHERE user_id = #{userId}
    </delete>
</mapper>
