# 复制这个文件为 application-local.yml，填上自己本机的 MySQL 密码。
# application-local.yml 已在 .gitignore 中，不会被提交，每人各写各的。
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/driving_school_v12?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: 这里填你自己的 MySQL 密码
